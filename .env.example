# Where film posters and backdrops come from: "letterboxd" (default) or "tmdb".
POSTER_SOURCE=letterboxd

# Needed only for POSTER_SOURCE=tmdb. Either a v3 API key or a v4 read access token.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional support tiles in the footer. Leave empty to hide a tile.
BMC_USERNAME=
GITHUB_SPONSORS_USERNAME=

PORT=3000

# Review lookups allowed per visitor IP per minute (each one hits Letterboxd).
RATE_LIMIT_PER_MINUTE=5

# Docker only: host port the container is published on (127.0.0.1 only).
HOST_PORT=3000

# Review lookups allowed per visitor IP per minute (each one hits Letterboxd).
RATE_LIMIT_PER_MINUTE=5

# Docker only: token for the optional Cloudflare Tunnel (see DEPLOY.md).
CLOUDFLARE_TUNNEL_TOKEN=
